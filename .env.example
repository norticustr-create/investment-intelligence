# =============================================================================
# Investment Intelligence — Environment Configuration Template
# =============================================================================
# Configure these variables in your hosting environment (e.g. Render Dashboard
# under "Environment Variables"). For Vite, these values are embedded into the
# static bundle at build time.
#
# DO NOT commit real secrets or credentials into this file or git repositories.

# Google OAuth 2.0 Web Client ID (from Google Cloud Console)
# If left as placeholder or empty, Google Sign-In remains disabled and the app
# runs in offline Synthetic Demo or Local Snapshot mode.
VITE_GOOGLE_CLIENT_ID="PLACEHOLDER_GOOGLE_CLIENT_ID.apps.googleusercontent.com"

# Cloud Backend API Base URL
# The HTTPS URL of the InvestmentAgentCloud FastAPI service on Render.
# e.g., https://investment-agent-cloud.onrender.com (or relative "" if same-domain)
VITE_CLOUD_API_BASE_URL="https://investment-agent-cloud.onrender.com"

# Cloud API Timeout in milliseconds
# Default is 45000 (45s) to accommodate Render free-tier cold starts.
VITE_CLOUD_API_TIMEOUT_MS="45000"
